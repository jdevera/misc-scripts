#!/usr/bin/env python3
# BRIEF: Print the absolute path of each given path
# DESC: Paths do not need to exist; each argument is resolved against the
# DESC: current directory and printed on its own line.
# USAGE: abspath PATH [PATH ...]

import os.path
import sys

if len(sys.argv) < 2:
    print("USAGE: abspath PATH [PATH ...]", file=sys.stderr)
    sys.exit(1)

for path in sys.argv[1:]:
    print(os.path.abspath(path))
