#!/usr/bin/env bash
# BRIEF: Set difference of two line files: lines in the first input but not the second
# DESC: Inputs are sorted and deduplicated automatically. Process
# DESC: substitutions work as inputs: set-difference <(cmd1) <(cmd2)
# USAGE: set-difference FILE_A FILE_B
# DEPS: comm

exec comm -23 <(sort -u "${1:?two input files required}") <(sort -u "${2:?two input files required}")
